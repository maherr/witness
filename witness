def _first_existing(var: str, defaults: list[str], config_key: str | None = None) -> str:
    override = os.environ.get(var) or (RUNTIME_CONFIG.get(config_key) if config_key else None)
    if override:
        return os.path.expanduser(override)
    expanded = [os.path.expanduser(path) for path in defaults]
    return next((path for path in expanded if os.path.exists(path)), expanded[0])


