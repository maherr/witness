def _iso_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def _valid_iso_timestamp(value: object) -> bool:
    if not isinstance(value, str) or not value.endswith("Z"):
        return False
    try:
        datetime.fromisoformat(value[:-1] + "+00:00")
    except ValueError:
        return False
    return True


def _safe_float(value: object) -> float | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    number = float(value)
    return number if math.isfinite(number) and number >= 0.0 else None


def _safe_int(value: object) -> int | None:
    if isinstance(value, bool) or not isinstance(value, int):
        return None
    return value if value >= 0 else None


def sanitize_ledger_record(record: dict) -> dict:
    """Return the fixed privacy-safe ledger schema.

    No caller-provided free-form string is serialized. Paths, filenames,
    transcript text, helper logs, and raw errors are structurally excluded.
    """
    safe: dict[str, object] = {"schema_version": LEDGER_SCHEMA_VERSION}
    run_id = record.get("run_id")
    safe["run_id"] = (
        run_id
        if isinstance(run_id, str) and re.fullmatch(r"[0-9a-f]{32}", run_id)
        else uuid.uuid4().hex
    )
    timestamp = record.get("timestamp")
    safe["timestamp"] = timestamp if _valid_iso_timestamp(timestamp) else _iso_now()

    for field, allowed in LEDGER_ENUMS.items():
        value = record.get(field)
        if isinstance(value, str) and value in allowed:
            safe[field] = value
        elif field == "status":
            safe[field] = "failed"
        elif field == "stage":
            safe[field] = "internal"
        elif field == "fallback_class":
            safe[field] = "other"
        elif field == "output_format":
            safe[field] = "unknown"
        elif field == "failure_class" and value is not None:
            safe[field] = "internal_error"
        else:
            safe[field] = None

    safe["diarization_enabled"] = (
        record.get("diarization_enabled")
        if isinstance(record.get("diarization_enabled"), bool)
        else None
    )
    for field in LEDGER_FLOAT_FIELDS:
        safe[field] = _safe_float(record.get(field))
    for field in LEDGER_INT_FIELDS:
        safe[field] = _safe_int(record.get(field))
    return {field: safe.get(field) for field in LEDGER_FIELDS}


def _open_safe_parent(path: Path) -> tuple[int, str]:
    """Open an absolute path's parent without following any symlink component."""
    absolute = Path(os.path.abspath(path))
    parts = absolute.parts
    if len(parts) < 2 or not absolute.is_absolute():
        raise OSError("ledger path must name a file")
    directory_flags = (
        os.O_RDONLY
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    directory_fd = os.open(os.path.sep, directory_flags)
    try:
        for component in parts[1:-1]:
            try:
                child_fd = os.open(component, directory_flags, dir_fd=directory_fd)
            except FileNotFoundError:
                try:
                    os.mkdir(component, mode=0o700, dir_fd=directory_fd)
                except FileExistsError:
                    pass
                child_fd = os.open(component, directory_flags, dir_fd=directory_fd)
            os.close(directory_fd)
            directory_fd = child_fd
        return directory_fd, parts[-1]
    except BaseException:
        os.close(directory_fd)
        raise


def append_ledger_record(record: dict) -> bool:
    """Append one mode-600 JSON record; ordinary I/O failure is non-fatal."""
    directory_fd: int | None = None
    fd: int | None = None
    try:
        directory_fd, filename = _open_safe_parent(Path(RUN_LOG_PATH))
        flags = (
            os.O_WRONLY
            | os.O_CREAT
            | os.O_APPEND
            | getattr(os, "O_NONBLOCK", 0)
            | getattr(os, "O_CLOEXEC", 0)
        )
        flags |= getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(filename, flags, 0o600, dir_fd=directory_fd)
        file_stat = os.fstat(fd)
        if not stat.S_ISREG(file_stat.st_mode) or file_stat.st_nlink != 1:
            return False
        os.fchmod(fd, 0o600)
        payload = (
            json.dumps(sanitize_ledger_record(record), sort_keys=True, separators=(",", ":"))
            + "\n"
        ).encode("utf-8")
        written = os.write(fd, payload)
        return written == len(payload)
    except (OSError, TypeError, ValueError):
        return False
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        if directory_fd is not None:
            try:
                os.close(directory_fd)
            except OSError:
                pass


def normalize_diarizer_backend(value: str | None) -> str:
    normalized = (value or "").lower()
    if normalized in {"gpu", "migraphx"}:
        return "gpu"
    if normalized == "cpu":
        return "cpu"
    if normalized == "disabled":
        return "disabled"
    return "unknown"


def classify_fallback(error: object) -> str:
    message = str(error).lower()
    if "not found" in message or "no such file" in message:
        return "dependency_missing"
    if "out of memory" in message or "oom" in message or "bad_alloc" in message:
        return "resource_exhausted"
    if (
        "same_dims" in message
        or "initializ" in message
        or "init failed" in message
        or "failed to init" in message
        or "failed to load" in message
    ):
        return "initialization_failed"
    if "without speaker segments" in message or "no speaker" in message:
        return "no_segments"
    if "exited" in message or "signal" in message or "abort" in message:
        return "process_failed"
    return "other"


def classify_failure(error: BaseException, stage: str) -> str:
    if isinstance(error, KeyboardInterrupt):
        return "interrupted"
    message = str(error).lower()
    if "file not found" in message:
        return "input_missing"
    if "too short" in message:
        return "input_too_short"
    if "dominant auto-detected language is unsupported" in message:
        return "unsupported_language"
    if "found no speech regions" in message:
        return "no_speech"
    if "found no usable speech turns" in message:
        return "no_speaker_turns"
    if "no transcription jobs" in message:
        return "no_windows"
    if "returned no transcript text" in message:
        return "no_transcript"
    if stage == "validation":
        return "invalid_arguments"
    if stage == "conversion":
        return "conversion_failed"
    if stage == "language_detection":
        return "language_detection_failed"
    if stage == "vad":
        return "vad_failed"
    if stage == "diarization":
        if "not found" in message:
            return "diarizer_unavailable"
        if classify_fallback(error) == "initialization_failed":
            return "diarizer_initialization_failed"
        return "diarization_failed"
    if stage == "windowing":
        return "windowing_failed"
    if stage == "transcription":
        if "not found" in message:
            return "ultra_unavailable"
        return "transcription_failed"
    if stage == "output":
        return "output_failed"
    return "internal_error"


class RunLedger:
    """Best-effort privacy-safe operational metrics for one CLI invocation."""

    def __init__(
        self,
        requested_language: str,
        diarization_enabled: bool,
        requested_diarizer: str,
        output_format: str,
        transcription_engine: str | None = None,
    ) -> None:
        self.started_monotonic = time.monotonic()
        self.terminal_written = False
        self.state: dict[str, object] = {
            "run_id": uuid.uuid4().hex,
            "status": "started",
            "stage": "validation",
            "requested_language": requested_language,
            "resolved_language": None,
            "language_confidence": None,
            "diarization_enabled": diarization_enabled,
            "requested_diarizer": requested_diarizer,
            "resolved_diarizer": "disabled" if not diarization_enabled else None,
            "fallback_class": "none",
            "duration_secs": None,
            "speakers_detected": None,
            "unknown_speech_secs": None,
            "windows": None,
            "segments": None,
            "output_format": output_format,
            "conversion_secs": None,
            "language_detection_secs": None,
            "vad_secs": None,
            "diarization_secs": None,
            "windowing_secs": None,
            "transcription_engine": transcription_engine,
            "transcription_secs": None,
            "output_secs": None,
            "pipeline_secs": None,
            "failure_class": None,
        }

    @property
    def stage(self) -> str:
        return str(self.state["stage"])

    def update(self, **values: object) -> None:
        self.state.update(values)

    def set_stage(self, stage: str) -> None:
        self.state["stage"] = stage

    def _write(self) -> bool:
        return append_ledger_record({**self.state, "timestamp": _iso_now()})

    def start(self) -> bool:
        return self._write()

    def complete(self) -> bool:
        if self.terminal_written:
            return False
        self.update(
            status="completed",
            stage="completed",
            pipeline_secs=time.monotonic() - self.started_monotonic,
            failure_class=None,
        )
        written = self._write()
        if written:
            self.terminal_written = True
        return written

    def fail(self, error: BaseException) -> bool:
        if self.terminal_written:
            return False
        stage = self.stage
        self.update(
            status="failed",
            pipeline_secs=time.monotonic() - self.started_monotonic,
            failure_class=classify_failure(error, stage),
        )
        if stage == "diarization" and self.state.get("requested_diarizer") == "auto":
            self.state["fallback_class"] = classify_fallback(error)
        written = self._write()
        if written:
            self.terminal_written = True
        return written


def _load_runtime_config() -> dict[str, str]:
    try:
        raw = json.loads(Path(RUNTIME_CONFIG_PATH).read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError, TypeError) as error:
        print(f"Warning: ignoring invalid Witness runtime config: {error}", file=sys.stderr)
        return {}
    return {str(key): str(value) for key, value in raw.items() if value}


